<Project Sdk="Microsoft.NET.Sdk">

  <!--
    VA 520 flow sensor tester - WinForms, .NET Framework 4.8.
    The code is deliberately kept at C# 5 syntax so that it also compiles with
    Mono's "mcs" compiler on the Raspberry Pi (see build_on_pi.sh).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>5</LangVersion>
    <RootNamespace>VA520Tester</RootNamespace>
    <AssemblyName>VA520Tester</AssemblyName>
    <Version>1.0.0</Version>
    <Platforms>AnyCPU</Platforms>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ErrorReport>none</ErrorReport>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src\**\*.cs" />
    <None Include="app.config" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <!-- Lets "dotnet build" work on machines without the .NET Framework 4.8 targeting pack. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
